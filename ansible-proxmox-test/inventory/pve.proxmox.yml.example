---
# Copie este arquivo para pve.proxmox.yml e preencha com os dados do seu ambiente.
# O arquivo pve.proxmox.yml está no .gitignore e não deve ser versionado.
plugin: community.proxmox.proxmox
url: "https://pve-node01.example.com:8006"
user: "ansible@pve"
token_id: "ansible"
token_secret: "00000000-0000-0000-0000-000000000000"
validate_certs: false

want_facts: true
want_proxmox_nodes_ansible_host: false

groups:
  test_vms: "'vm-test-ubuntu' in proxmox_name or 'vm-test-debian' in proxmox_name"

compose:
  ansible_user: "'ansible'"
